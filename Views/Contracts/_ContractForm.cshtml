@model ConstructionProjectManagement.ViewModels.ContractEditViewModel
@using ConstructionProjectManagement.Models
@{
    var projects = (IReadOnlyCollection<Project>)ViewBag.Projects;
    var parties = (IReadOnlyCollection<ContractParty>)ViewBag.Parties;
}

<form asp-action="@(Model.Id is null ? "Create" : "Edit")" asp-route-id="@Model.Id" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="card">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-12">
                    <label class="form-label">Dự án liên quan (chọn một hoặc nhiều)</label>
                    <div class="row g-2">
                    @foreach (var project in projects)
                    {
                        var allocated = Model.AllocatedValues.TryGetValue(project.Id, out var value) ? value : 0;
                        <div class="col-md-6">
                            <div class="input-group">
                                <span class="input-group-text">
                                    <input class="form-check-input mt-0" type="checkbox" name="ProjectIds" value="@project.Id"
                                           @(Model.ProjectIds.Contains(project.Id) ? "checked" : null) />
                                </span>
                                <span class="form-control">@project.ProjectCode - @project.Name</span>
                                <input class="form-control" type="number" name="AllocatedValues[@project.Id]" value="@allocated" step="0.01" aria-label="Giá trị phân bổ" />
                            </div>
                        </div>
                    }
                    </div>
                </div>
                <div class="col-md-12">
                    <label asp-for="Title" class="form-label"></label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ContractNumber" class="form-label"></label>
                    <input asp-for="ContractNumber" class="form-control" />
                    <span asp-validation-for="ContractNumber" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ContractType" class="form-label"></label>
                    <select asp-for="ContractType" asp-items="Html.GetEnumSelectList<ContractType>()" class="form-select"></select>
                </div>
                <div class="col-md-6">
                    <label asp-for="ClientPartyId" class="form-label"></label>
                    <select asp-for="ClientPartyId" class="form-select">
                        <option value="">-- Chọn chủ đầu tư --</option>
                        @foreach (var party in parties.Where(item => item.PartyRole == ContractPartyRole.Client))
                        { <option value="@party.Id">@party.Name</option> }
                    </select>
                </div>
                <div class="col-md-6">
                    <label asp-for="ContractorPartyId" class="form-label"></label>
                    <select asp-for="ContractorPartyId" class="form-select">
                        <option value="">-- Chọn nhà thầu --</option>
                        @foreach (var party in parties.Where(item => item.PartyRole != ContractPartyRole.Client))
                        { <option value="@party.Id">@party.Name</option> }
                    </select>
                </div>
                <div class="col-md-6">
                    <label asp-for="ContractValue" class="form-label"></label>
                    <input asp-for="ContractValue" class="form-control" />
                    <span asp-validation-for="ContractValue" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="Currency" class="form-label"></label>
                    <input asp-for="Currency" class="form-control" />
                </div>
                <div class="col-md-9">
                    <label asp-for="ScopeOfWork" class="form-label"></label>
                    <textarea asp-for="ScopeOfWork" class="form-control" rows="3"></textarea>
                </div>
                <div class="col-md-3">
                    <label asp-for="SignedDate" class="form-label"></label>
                    <input asp-for="SignedDate" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="EffectiveDate" class="form-label"></label>
                    <input asp-for="EffectiveDate" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="EndDate" class="form-label"></label>
                    <input asp-for="EndDate" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="ProgressPercentage" class="form-label"></label>
                    <input asp-for="ProgressPercentage" class="form-control" min="0" max="100" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Status" class="form-label"></label>
                    <select asp-for="Status" asp-items="Html.GetEnumSelectList<ContractStatus>()" class="form-select"></select>
                </div>
            </div>
            <div class="mt-4">
                <button type="submit" class="btn btn-primary">Lưu</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
