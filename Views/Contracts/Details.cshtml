@model ConstructionProjectManagement.ViewModels.ContractDetailsViewModel
@using ConstructionProjectManagement.Models
@{
    ViewData["Title"] = "Chi tiết hợp đồng";
    var contract = Model.Contract;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-1">@contract.ContractNumber</h1>
        <div class="text-muted">@contract.Title</div>
    </div>
    @if (contract.IsArchived &&
         (User.IsInRole("Admin") || User.IsInRole("Project Director") || User.IsInRole("Project Manager")))
    {
        <form asp-action="Restore" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@contract.Id" />
            <button class="btn btn-success">Khôi phục hợp đồng</button>
        </form>
    }
    @if (!contract.IsArchived && (User.IsInRole("Project Director") || User.IsInRole("Project Manager")))
    {
        <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@contract.Id">Cập nhật</a>
    }
</div>

@if (contract.IsArchived)
{
    <div class="alert alert-warning">
        <strong>Hợp đồng đã lưu trữ</strong>
        @if (contract.ArchivedAt.HasValue)
        {
            <span> ngày @contract.ArchivedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
        }
        @if (!string.IsNullOrWhiteSpace(contract.ArchiveReason))
        {
            <div>Lý do: @contract.ArchiveReason</div>
        }
    </div>
}

@if (TempData["SuccessMessage"] is string successMessage) { <div class="alert alert-success">@successMessage</div> }
@if (TempData["ErrorMessage"] is string errorMessage) { <div class="alert alert-danger">@errorMessage</div> }

<ul class="nav nav-tabs mb-3" role="tablist">
    <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#general" type="button">Thông tin chung</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#amendments" type="button">Phụ lục hợp đồng</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#documents" type="button">Tài liệu</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#history" type="button">Lịch sử</button></li>
</ul>

<div class="tab-content">
    <div class="tab-pane fade show active" id="general">
        <div class="card"><div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">Dự án</dt><dd class="col-sm-9">@string.Join(", ", contract.ContractProjects.Select(item => item.Project.ProjectCode + " - " + item.Project.Name))</dd>
                <dt class="col-sm-3">Loại hợp đồng</dt><dd class="col-sm-9">@contract.ContractType</dd>
                <dt class="col-sm-3">Chủ đầu tư</dt><dd class="col-sm-9">@(contract.ClientParty?.Name ?? contract.ClientName)</dd>
                <dt class="col-sm-3">Nhà thầu</dt><dd class="col-sm-9">@(contract.ContractorParty?.Name ?? contract.ContractorName)</dd>
                <dt class="col-sm-3">Giá trị gốc / hiện tại</dt><dd class="col-sm-9">@contract.OriginalValue.ToString("N0") / @contract.CurrentValue.ToString("N0") @contract.Currency</dd>
                <dt class="col-sm-3">Ngày ký / hiệu lực / hết hạn</dt><dd class="col-sm-9">@contract.SignedDate?.ToString("dd/MM/yyyy") / @contract.EffectiveDate?.ToString("dd/MM/yyyy") / @contract.EndDate?.ToString("dd/MM/yyyy")</dd>
                <dt class="col-sm-3">Trạng thái</dt>
                <dd class="col-sm-9">
                    @contract.Status
                    @if (contract.Status == ContractStatus.InProgress && contract.EffectiveDate.HasValue)
                    {
                        <span class="badge @(DateTime.Today < contract.EffectiveDate.Value.Date ? "text-bg-warning" : "text-bg-success")">
                            @(DateTime.Today < contract.EffectiveDate.Value.Date ? "Chưa đến ngày hiệu lực" : "Đang hiệu lực")
                        </span>
                    }
                </dd>
                <dt class="col-sm-3">Tiến độ</dt><dd class="col-sm-9">@contract.ProgressPercentage%</dd>
                <dt class="col-sm-3">Phạm vi công việc</dt><dd class="col-sm-9">@contract.ScopeOfWork</dd>
                @if (!string.IsNullOrWhiteSpace(contract.RejectionReason))
                {
                    <dt class="col-sm-3">Lý do từ chối</dt><dd class="col-sm-9 text-danger">@contract.RejectionReason</dd>
                }
            </dl>
        </div></div>
    </div>

    <div class="tab-pane fade" id="amendments">
        @if (!contract.IsArchived && (User.IsInRole("Project Director") || User.IsInRole("Project Manager")))
        {
            <form asp-action="CreateAmendment" method="post" class="card card-body mb-3">
                @Html.AntiForgeryToken()
                <input type="hidden" name="contractId" value="@contract.Id" />
                <div class="row g-2">
                    <div class="col-md-4"><input class="form-control" name="title" placeholder="Tên phụ lục" required /></div>
                    <div class="col-md-2"><input class="form-control" type="date" name="effectiveDate" required /></div>
                    <div class="col-md-2"><input class="form-control" type="number" step="0.01" name="valueAdjustment" value="0" /></div>
                    <div class="col-md-2"><input class="form-control" type="date" name="newExpirationDate" /></div>
                    <div class="col-md-12"><textarea class="form-control" name="changeDescription" placeholder="Nội dung thay đổi" required></textarea></div>
                    <div class="col-md-12"><button class="btn btn-primary">Tạo phụ lục</button></div>
                </div>
            </form>
        }
        <div class="card"><div class="table-responsive"><table class="table mb-0">
            <thead><tr><th>Số phụ lục</th><th>Tiêu đề</th><th>Điều chỉnh</th><th>Hết hạn mới</th><th>Trạng thái</th></tr></thead>
            <tbody>
            @foreach (var amendment in contract.Amendments)
            {
                <tr>
                    <td>@amendment.AmendmentNumber</td><td>@amendment.Title</td>
                    <td>@amendment.ValueAdjustment.ToString("N0")</td><td>@amendment.NewExpirationDate?.ToString("dd/MM/yyyy")</td><td>@amendment.ApprovalStatus</td>
                </tr>
            }
            </tbody>
        </table></div></div>
    </div>

    <div class="tab-pane fade" id="documents">
        <div class="card"><div class="list-group list-group-flush">
        @foreach (var document in contract.Documents)
        {
            <div class="list-group-item d-flex justify-content-between"><span>@document.FileName</span><a asp-action="DownloadDocument" asp-route-id="@document.Id">Tải xuống</a></div>
        }
        </div></div>
    </div>

    <div class="tab-pane fade" id="history">
        <h2 class="h5">Lịch sử biến động giá trị</h2>
        @if (contract.ValueHistories.Count == 0)
        {
            <p class="text-muted">Chưa có biến động giá trị.</p>
        }
        else
        {
            <div class="table-responsive mb-4">
                <table class="table table-sm">
                    <thead><tr><th>Thời điểm</th><th>Giá trị trước</th><th>Điều chỉnh</th><th>Giá trị sau</th><th>Người ghi nhận</th><th>Ghi chú</th></tr></thead>
                    <tbody>
                    @foreach (var entry in contract.ValueHistories.OrderByDescending(item => item.RecordedAt))
                    {
                        <tr>
                            <td>@entry.RecordedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@entry.PreviousValue.ToString("N0")</td>
                            <td>@entry.AdjustmentAmount.ToString("N0")</td>
                            <td>@entry.NewValue.ToString("N0")</td>
                            <td>@(entry.RecordedBy.FullName ?? entry.RecordedBy.Email ?? entry.RecordedById)</td>
                            <td>@entry.Note</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }

        <h2 class="h5">Lịch sử thao tác</h2>
        @if (contract.AuditLogs.Count == 0)
        {
            <p class="text-muted">Chưa có lịch sử thao tác.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm">
                    <thead><tr><th>Thời điểm</th><th>Thao tác</th><th>Người thực hiện</th><th>Ghi chú</th></tr></thead>
                    <tbody>
                    @foreach (var entry in contract.AuditLogs.OrderByDescending(item => item.PerformedAt))
                    {
                        <tr>
                            <td>@entry.PerformedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@entry.Action</td>
                            <td>@(entry.PerformedBy.FullName ?? entry.PerformedBy.Email ?? entry.PerformedById)</td>
                            <td>@entry.Comment</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@if (!contract.IsArchived)
{
    <div class="d-flex gap-2 mt-3">
        @if (contract.Status == ContractStatus.Draft && (User.IsInRole("Project Director") || User.IsInRole("Project Manager")))
        { <form asp-action="Submit" method="post"><input type="hidden" name="id" value="@contract.Id" />@Html.AntiForgeryToken()<button class="btn btn-primary">Gửi duyệt</button></form> }
        @if (contract.Status == ContractStatus.PendingApproval && contract.ApprovalStep == 1)
        { <form asp-action="Review" method="post"><input type="hidden" name="id" value="@contract.Id" />@Html.AntiForgeryToken()<button class="btn btn-info">Kiểm tra bước 1</button></form> }
        @if (contract.Status == ContractStatus.PendingApproval && contract.ApprovalStep == 2 && User.IsInRole("Project Director"))
        { <form asp-action="Approve" method="post"><input type="hidden" name="id" value="@contract.Id" />@Html.AntiForgeryToken()<button class="btn btn-success">Phê duyệt bước 2</button></form> }
        @if (User.IsInRole("Project Director") || User.IsInRole("Project Manager"))
        { <form asp-action="Archive" method="post"><input type="hidden" name="id" value="@contract.Id" /><input type="hidden" name="reason" value="[FAKE-TASK03] Kiểm thử archive" />@Html.AntiForgeryToken()<button class="btn btn-outline-danger">Archive</button></form> }
    </div>
}
