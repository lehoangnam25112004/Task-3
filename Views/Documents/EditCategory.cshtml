@model ConstructionProjectManagement.Models.DocumentCategory
@{
    ViewData["Title"] = Model.Id == 0 ? "Thêm danh mục" : "Sửa danh mục";
}

<div class="mb-3">
    <a asp-action="Categories" class="text-decoration-none">&larr; Danh mục tài liệu</a>
    <h1 class="h3 mt-1">@ViewData["Title"]</h1>
</div>
<div class="card">
    <div class="card-body">
        <form asp-action="SaveCategory" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="Id" type="hidden" />
            <input asp-for="IsActive" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="Code" class="form-label">Mã danh mục</label>
                    <input asp-for="Code" class="form-control" />
                    <span asp-validation-for="Code" class="text-danger"></span>
                </div>
                <div class="col-md-8">
                    <label asp-for="Name" class="form-label">Tên danh mục</label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="ApprovalLevels" class="form-label">Số cấp phê duyệt</label>
                    <select asp-for="ApprovalLevels" class="form-select">
                        <option value="0">Không cần duyệt</option>
                        <option value="1">Một cấp</option>
                        <option value="2">Hai cấp</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label asp-for="AllowedExtensions" class="form-label">Định dạng cho phép</label>
                    <input asp-for="AllowedExtensions" class="form-control" placeholder=".pdf,.png,.jpg,.docx,.xlsx" />
                    <div class="form-text">Để trống để dùng toàn bộ định dạng được hệ thống hỗ trợ.</div>
                </div>
                <div class="col-md-4">
                    <label asp-for="DisplayOrder" class="form-label">Thứ tự hiển thị</label>
                    <input asp-for="DisplayOrder" class="form-control" type="number" />
                </div>
                <div class="col-12">
                    <label asp-for="Description" class="form-label">Mô tả</label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                </div>
            </div>
            <div class="d-flex gap-2 mt-3">
                <button class="btn btn-primary" type="submit">Lưu danh mục</button>
                <a asp-action="Categories" class="btn btn-outline-secondary">Hủy</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
