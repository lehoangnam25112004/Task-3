@model ConstructionProjectManagement.ViewModels.WorkItemViewModel
@using ConstructionProjectManagement.Models
@using ConstructionProjectManagement.ViewModels
@{
    ViewData["Title"] = "Chỉnh sửa hạng mục WBS";
    var phases = (IReadOnlyCollection<ProjectPhase>)ViewBag.Phases;
    var workItems = (IReadOnlyCollection<WorkItem>)ViewBag.WorkItems;
}

<h1 class="h3 mb-3">Chỉnh sửa hạng mục WBS</h1>
<form asp-action="EditItem" asp-route-id="@Model.Id" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <input asp-for="Id" type="hidden" />
    <input asp-for="ProjectId" type="hidden" />
    <div class="card card-body">
        <div class="mb-3">
            <label asp-for="ProjectPhaseId" class="form-label"></label>
            <select asp-for="ProjectPhaseId" class="form-select">
                @foreach (var phase in phases)
                {
                    <option value="@phase.Id">@phase.SequenceOrder - @phase.Name</option>
                }
            </select>
            <span asp-validation-for="ProjectPhaseId" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="ParentWorkItemId" class="form-label"></label>
            <select asp-for="ParentWorkItemId" class="form-select">
                <option value="">-- Hạng mục gốc --</option>
                @foreach (var item in workItems.Where(item => item.Id != Model.Id))
                {
                    <option value="@item.Id" data-phase-id="@item.ProjectPhaseId">@item.WbsCode - @item.Name</option>
                }
            </select>
            <span asp-validation-for="ParentWorkItemId" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="WbsCode" class="form-label"></label>
            <input asp-for="WbsCode" class="form-control" />
            <span asp-validation-for="WbsCode" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="SequenceOrder" class="form-label"></label>
            <input asp-for="SequenceOrder" class="form-control" />
            <span asp-validation-for="SequenceOrder" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Status" class="form-label"></label>
            <select asp-for="Status" class="form-select">
                @foreach (var status in Enum.GetValues<WbsItemStatus>().Where(status => status != WbsItemStatus.Archived))
                {
                    <option value="@status" selected="@(Model.Status == status)">@WbsStatusLabels.For(status)</option>
                }
            </select>
        </div>
        <div>
            <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
            <a asp-action="Index" asp-route-projectId="@Model.ProjectId" class="btn btn-outline-secondary">Hủy</a>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const phaseSelect = document.getElementById("ProjectPhaseId");
        const parentSelect = document.getElementById("ParentWorkItemId");
        const updateParents = () => {
            const phaseId = phaseSelect.value;
            for (const option of parentSelect.options) {
                if (option.value) {
                    option.hidden = option.dataset.phaseId !== phaseId;
                    if (option.hidden && option.selected) {
                        parentSelect.value = "";
                    }
                }
            }
        };
        phaseSelect.addEventListener("change", updateParents);
        updateParents();
    </script>
}
